# Все VITE_* переменные попадают в бандл и ПУБЛИЧНЫ. Никаких секретов здесь.
# Скопируй в .env.local, если нужно что-то поменять. По умолчанию ничего настраивать не нужно.

# Куда dev-сервер проксирует /api.php (локальный бэкенд из local-proj). Не попадает в бандл.
API_PROXY_TARGET=http://localhost:8080

# Адрес API в собранном приложении. По умолчанию /api.php (тот же origin, как в проде за nginx).
# VITE_API_URL=/api.php

# MSW-моки вместо бэкенда. Обычно не трогай: используй pnpm dev:mocks.
# VITE_API_MOCKS=true

# Симулятор АТС вне режима моков: проверка карточки звонка против локального бэкенда.
# В консоли браузера: window.__elevnAts.incoming('+77076281068'), .answer(), .hangup()
# VITE_ATS_SIMULATOR=true

# Прямые запросы к Green API из браузера (как в старом фронте). ВЫКЛЮЧЕНО по умолчанию:
# токены инстансов WhatsApp не должны попадать во фронт. Нужен прокси на бэкенде.
# VITE_WHATSAPP_DIRECT=true
# VITE_GREEN_API_URL=https://api.green-api.com
